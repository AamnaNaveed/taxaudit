#' Context-Anchored Organ Feature Extractor for Real Flora Prose
#' @param text Character string of full botanical treatment
#' @return A structured list of extracted organ traits
#' @export
extract_real_traits <- function(text) {
if (is.na(text)) return(NULL)
gf <- NA_character_
if (grepl("tree|shrub|herb|liana|climber", text, ignore.case = TRUE)) {
if (grepl("tree", text, ignore.case = TRUE)) gf <- "tree"
else if (grepl("shrub", text, ignore.case = TRUE)) gf <- "shrub"
}
extract_window_trait <- function(keyword, txt) {
pos <- regexpr(paste0("\\b", keyword, "\\b"), txt, ignore.case = TRUE)
if (pos == -1) pos <- regexpr(keyword, txt, ignore.case = TRUE)
if (pos == -1) return(NULL)
# Expand window slightly backward (up to 30 chars) to catch leading parentheticals like (2.5-)
start_pos <- max(1, pos - 30)
sub_txt <- substr(txt, start_pos, nchar(txt))
end_pos <- regexpr("[\\.]", sub_txt)
window <- if (end_pos > 0) substr(sub_txt, 1, end_pos) else substr(sub_txt, 1, 180)
res <- parse_botanical_range(window)
if (!is.null(res) && is.na(res$unit)) {
if (grepl("\\bcm\\b", sub_txt, ignore.case = TRUE)) res$unit <- "cm"
else if (grepl("\\bmm\\b", sub_txt, ignore.case = TRUE)) res$unit <- "mm"
else if (grepl("\\bm\\b", sub_txt, ignore.case = TRUE)) res$unit <- "m"
}
res
}
list(
growth_form = gf,
leaf_dimensions = extract_window_trait("leaves|lamina", text),
reproductive_size = extract_window_trait("reproductive|cones|capsules|fruit|acorns", text)
)
}
