#' Load a botanical treatment text from the corpus
#' @param taxon_name Character string name of the taxon
#' @return Character string of the treatment text
#' @export
extract_description <- function(taxon_name) {
filename <- paste0(gsub(" ", "_", taxon_name), ".txt")
# 1. Try standard package installed / system.file path first
filepath <- system.file("extdata", "corpus", filename, package = "taxaudit")
# 2. Fall back to local development paths if system.file() is empty
if (filepath == "" || !file.exists(filepath)) {
paths <- c(
file.path("inst", "extdata", "corpus", filename),
file.path("..", "..", "inst", "extdata", "corpus", filename),
file.path(".", "inst", "extdata", "corpus", filename),
file.path("extdata", "corpus", filename),
file.path("..", "extdata", "corpus", filename),
file.path("tests", "testthat", "inst", "extdata", "corpus", filename)
)
filepath <- NULL
for (p in paths) {
if (file.exists(p)) { filepath <- p; break }
}
if (is.null(filepath)) return(NA_character_)
}
raw_lines <- readLines(filepath, warn = FALSE)
paste(gsub("\\s+", " ", trimws(raw_lines)), collapse = " ")
}
rm(list = ls())
devtools::load_all(reset = TRUE)
devtools::test()
#' Load a botanical treatment text from the corpus
#' @param taxon_name Character string name of the taxon
#' @return Character string of the treatment text
#' @export
extract_description <- function(taxon_name) {
filename <- paste0(gsub(" ", "_", taxon_name), ".txt")
# Check absolute and relative candidates across all possible test/dev environments
candidates <- c(
file.path("inst", "extdata", "corpus", filename),
file.path("..", "..", "inst", "extdata", "corpus", filename),
file.path(".", "inst", "extdata", "corpus", filename),
file.path("extdata", "corpus", filename),
file.path("..", "extdata", "corpus", filename),
file.path("tests", "testthat", "inst", "extdata", "corpus", filename),
file.path(getwd(), "inst", "extdata", "corpus", filename),
file.path(getwd(), "..", "inst", "extdata", "corpus", filename)
)
filepath <- NULL
for (p in candidates) {
if (file.exists(p)) {
filepath <- normalizePath(p)
break
}
}
if (is.null(filepath) || !file.exists(filepath)) {
return(NA_character_)
}
raw_lines <- readLines(filepath, warn = FALSE)
paste(gsub("\\s+", " ", trimws(raw_lines)), collapse = " ")
}
