audit <- ta_audit_agreement(corpus)
expect_s3_class(audit, "data.frame")
splits <- ta_split_evaluation(corpus, split_by = "taxon")
expect_type(splits, "list")
expect_true("train" %in% names(splits))
expect_true("test" %in% names(splits))
})
'
